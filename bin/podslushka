#!/bin/bash
# Подслушка — запись звонка и протокол
# start | stop | status | toggle | doctor | setup | fix-audio | protocol | pdf
# Пишет микрофон и звук системы через агрегатное устройство "Podslushka In",
# после стопа сразу расшифровывает локальным faster-whisper.

set -uo pipefail

# Приложение, запущенное из Finder, получает PATH от launchd — без
# /opt/homebrew/bin. Из терминала тот же скрипт работает, из панели падает
# на «не найден ffmpeg». Поэтому пути задаются здесь, а не наследуются.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

HOME_DIR="${PODSLUSHKA_HOME:-$HOME/.podslushka}"
DEVICE_NAME="${PODSLUSHKA_DEVICE:-Podslushka In}"
BASE_DIR="${PODSLUSHKA_DIR:-$HOME/Подслушка}"
STATE_DIR="/tmp/podslushka"
PID_FILE="$STATE_DIR/ffmpeg.pid"
CUR_FILE="$STATE_DIR/current"
LOG_FILE="$STATE_DIR/ffmpeg.log"
WHISPER_PY="$HOME_DIR/venv/bin/python"
TRANSCRIBE="$HOME_DIR/lib/transcribe.py"
PROTOCOL="$HOME_DIR/lib/protocol.py"
TOPDF="$HOME_DIR/lib/topdf.py"
MODEL2="${PODSLUSHKA_MODEL2:-large-v3}"
SECOND_PASS="${PODSLUSHKA_SECOND_PASS:-1}"
PEAKS="$HOME_DIR/lib/make_peaks.py"
KEEP_WAV="${PODSLUSHKA_KEEP_WAV:-0}"

mkdir -p "$STATE_DIR" "$BASE_DIR"

notify() { osascript -e "display notification \"$2\" with title \"Подслушка\"" >/dev/null 2>&1; }

find_device_index() {
  ffmpeg -hide_banner -f avfoundation -list_devices true -i "" 2>&1 \
    | awk '/AVFoundation audio devices/{a=1;next} /AVFoundation video devices/{a=0} a' \
    | grep -F "$DEVICE_NAME" | head -1 | sed -E 's/.*\[([0-9]+)\].*/\1/'
}

# Мало проверить, что процесс с таким номером жив: после перезагрузки номер
# достаётся кому-то другому, и запись выглядит идущей, хотя её нет. Поэтому
# проверяем, что это действительно наш ffmpeg, а протухший файл убираем.
is_running() {
  [ -f "$PID_FILE" ] || return 1
  local pid cmd
  pid="$(cat "$PID_FILE" 2>/dev/null)"
  case "$pid" in
    ''|*[!0-9]*) rm -f "$PID_FILE"; return 1 ;;
  esac
  cmd="$(ps -p "$pid" -o comm= 2>/dev/null)"
  case "$cmd" in
    *ffmpeg*) return 0 ;;
    *) rm -f "$PID_FILE"; return 1 ;;
  esac
}

# Ранний отказ тоже пишется в журнал: иначе окно отправляет смотреть файл,
# которого нет.
fail() {
  local msg="$1"
  shift
  mkdir -p "$STATE_DIR"
  {
    echo "=== $(date +%H:%M:%S) старт не состоялся"
    echo "$msg"
    echo "PATH=$PATH"
    if [ $# -gt 0 ]; then printf '%s\n' "$@"; fi
  } > "$LOG_FILE"
  echo "$msg"
  notify "" "$msg"
  exit 1
}

do_start() {
  if is_running; then echo "уже пишется: $(cat "$CUR_FILE")"; exit 0; fi
  command -v ffmpeg >/dev/null \
    || fail "не найден ffmpeg, проверь установку через install.sh"

  IDX="$(find_device_index)"
  if [ -z "$IDX" ]; then
    fail "не найдено аудиоустройство \"$DEVICE_NAME\", собери его: podslushka setup" \
      "$(ffmpeg -hide_banner -f avfoundation -list_devices true -i "" 2>&1 | sed -n '/audio devices/,$p')"
  fi

  OUT_DIR="$BASE_DIR/$(date +%Y-%m-%d_%H-%M-%S)"
  mkdir -p "$OUT_DIR"
  echo "$OUT_DIR" > "$CUR_FILE"

  echo "=== старт $(date +%H:%M:%S), устройство [$IDX] $DEVICE_NAME" > "$LOG_FILE"
  nohup ffmpeg -hide_banner -loglevel info -nostdin \
    -f avfoundation -i ":$IDX" \
    -c:a pcm_s16le -ar 48000 \
    "$OUT_DIR/audio.wav" >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"

  sleep 1
  if ! is_running; then
    echo "ffmpeg не стартовал:"; cat "$LOG_FILE"; rm -f "$PID_FILE"; exit 1
  fi
  echo "REC → $OUT_DIR/audio.wav"
  notify "" "Идёт запись"
}

do_stop() {
  if ! is_running; then echo "запись не идёт"; notify "" "Записи не было"; exit 0; fi
  PID="$(cat "$PID_FILE")"
  echo "=== стоп $(date +%H:%M:%S), pid $PID, размер до остановки $(stat -f%z "$(cat "$CUR_FILE")/audio.wav" 2>/dev/null) байт" >> "$LOG_FILE"
  kill -INT "$PID" 2>/dev/null
  for _ in $(seq 1 20); do kill -0 "$PID" 2>/dev/null || break; sleep 0.5; done
  kill -0 "$PID" 2>/dev/null && kill -9 "$PID" 2>/dev/null
  rm -f "$PID_FILE"

  OUT_DIR="$(cat "$CUR_FILE" 2>/dev/null)"
  WAV="$OUT_DIR/audio.wav"
  [ -s "$WAV" ] || { echo "файл пустой: $WAV"; notify "" "Пустой файл"; exit 1; }

  # вывод ffmpeg кладётся рядом с записью — иначе он теряется в /tmp
  cp -f "$LOG_FILE" "$OUT_DIR/ffmpeg.log" 2>/dev/null

  SIZE=$(du -h "$WAV" | cut -f1)
  echo "Запись остановлена ($SIZE). Транскрибирую…"
  notify "" "Стоп. Транскрибирую…"

  if ! "$WHISPER_PY" "$TRANSCRIBE" "$WAV"; then
    notify "" "Ошибка транскрибации"
    echo "Расшифровка упала, аудио цело: $WAV"
    exit 1
  fi

  "$WHISPER_PY" "$PEAKS" "$WAV" || echo "  пики не посчитались"

  # WAV 48 кГц — около гигабайта в час, поэтому после расшифровки жмём в m4a
  if [ "$KEEP_WAV" != "1" ]; then
    if ffmpeg -v error -y -i "$WAV" -ac 1 -c:a aac -b:a 64k \
         -movflags +faststart "$OUT_DIR/audio.m4a"; then
      echo "  сжато: $(du -h "$WAV" | cut -f1) → $(du -h "$OUT_DIR/audio.m4a" | cut -f1)"
      rm -f "$WAV"
    else
      echo "  сжатие не вышло, оставляю WAV"
    fi
  fi

  AUDIO="$OUT_DIR/audio.m4a"; [ -f "$AUDIO" ] || AUDIO="$WAV"

  # Второй проход точной моделью идёт в фоне: черновик уже есть, а точный текст
  # подъезжает позже и перезаписывает transcript.*. Черновик остаётся рядом.
  if [ "$SECOND_PASS" = "1" ] && [ -n "$MODEL2" ] && [ "$MODEL2" != "${PODSLUSHKA_MODEL:-medium}" ]; then
    cp -f "$OUT_DIR/transcript.txt" "$OUT_DIR/transcript-draft.txt" 2>/dev/null
    nohup bash -c "
      PODSLUSHKA_MODEL='$MODEL2' '$WHISPER_PY' '$TRANSCRIBE' '$AUDIO' \
        && osascript -e 'display notification \"Точная расшифровка готова\" with title \"Подслушка\"' \
        || osascript -e 'display notification \"Второй проход не удался\" with title \"Подслушка\"'
    " > "$OUT_DIR/second-pass.log" 2>&1 &
    echo "  второй проход ($MODEL2) идёт в фоне, журнал: $OUT_DIR/second-pass.log"
  fi

  echo "Готово: $OUT_DIR"
  notify "" "Транскрипт готов"
  open "$OUT_DIR"
}

# Выбранная папка кладётся в DIR, а не печатается: подстановка $(...) уходит
# в подоболочку, и выход по ошибке оттуда не останавливает вызывающего.
DIR=""
pick_dir() {
  if [ -n "${1:-}" ]; then
    DIR="${1%/}"
    [ -d "$DIR" ] || { echo "нет папки: $DIR"; return 1; }
    return 0
  fi
  local d
  d="$(ls -dt "$BASE_DIR"/*/ 2>/dev/null | head -1)"
  if [ -z "$d" ]; then
    echo "В $BASE_DIR записей нет."
    echo "Если записи лежат в другом месте, укажи папку явно или задай PODSLUSHKA_DIR."
    return 1
  fi
  DIR="${d%/}"
}

do_protocol() {
  pick_dir "${1:-}" || return 1
  local D="$DIR"
  echo "Протокол по $D"
  "$WHISPER_PY" "$PROTOCOL" "$D" || return 1
  if [ -f "$D/protocol.md" ]; then
    "$WHISPER_PY" "$TOPDF" "$D/protocol.md" "$D/protocol.pdf" && open "$D"
  fi
}

do_pdf() {
  pick_dir "${1:-}" || return 1
  local D="$DIR"
  [ -f "$D/protocol.md" ] || { echo "нет $D/protocol.md — сначала podslushka protocol"; return 1; }
  "$WHISPER_PY" "$TOPDF" "$D/protocol.md" "$D/protocol.pdf" && open "$D"
}

do_doctor() {
  local ok=0
  check() { if eval "$2" >/dev/null 2>&1; then echo "  есть   $1"; else echo "  НЕТ    $1"; ok=1; fi; }
  echo "Подслушка, проверка окружения:"
  check "ffmpeg"                 "command -v ffmpeg"
  check "драйвер BlackHole 2ch"  "test -d /Library/Audio/Plug-Ins/HAL/BlackHole2ch.driver"
  check "python окружения"       "test -x '$WHISPER_PY'"
  check "faster-whisper"         "'$WHISPER_PY' -c 'import faster_whisper'"
  check "устройство ${DEVICE_NAME}" "test -n \"\$(find_device_index)\""
  check "папка записей"          "test -d '$BASE_DIR' || mkdir -p '$BASE_DIR'"
  echo "  ---- для протоколов, не обязательно ----"
  if [ -d "$HOME/.cache/huggingface/hub/models--Systran--faster-whisper-$MODEL2" ]; then
    echo "  есть   точная модель $MODEL2"
  else
    echo "  нет    точной модели $MODEL2 — скачается при первом втором проходе"
  fi
  if command -v ollama >/dev/null; then
    echo "  есть   ollama, протокол соберётся офлайн"
  else
    echo "  нет    ollama — протокол выйдет заготовкой для внешней модели"
  fi
  echo
  if [ "$ok" = 0 ]; then echo "Всё на месте."; else echo "Чего-то не хватает — запусти install.sh"; fi
  return $ok
}

do_setup() {
  APP="$HOME/Applications/Podslushka.app/Contents/MacOS/Podslushka"
  [ -x "$APP" ] || { echo "нет приложения, собери: $HOME_DIR/app/build.sh"; exit 1; }
  echo "Доступные устройства:"; "$APP" --devices
  echo
  echo "Создать вход и выход из микрофона и наушников:"
  echo "  \"$APP\" --mic \"Микрофон MacBook Pro\" --out \"Динамики MacBook Pro\" --make-devices"
}

do_fix_audio() {
  APP="$HOME/Applications/Podslushka.app/Contents/MacOS/Podslushka"
  if [ -x "$APP" ]; then
    "$APP" --restore-output
  else
    echo "нет приложения. Верни выход вручную: Option и клик по значку звука в строке меню."
    exit 1
  fi
}

case "${1:-toggle}" in
  doctor) do_doctor; exit $? ;;
  fix-audio) do_fix_audio; exit $? ;;
  protocol) shift; do_protocol "${1:-}"; exit $? ;;
  pdf) shift; do_pdf "${1:-}"; exit $? ;;
  setup) do_setup ;;
  start) do_start ;;
  stop) do_stop ;;
  status)
    if is_running; then
      echo "идёт запись: $(cat "$CUR_FILE" 2>/dev/null)"
      echo "процесс: $(ps -p "$(cat "$PID_FILE")" -o pid=,comm= 2>/dev/null)"
    else
      echo "запись не идёт"
      [ -f "$PID_FILE" ] || echo "состояние чистое"
    fi
    ;;
  toggle) is_running && do_stop || do_start ;;
  *) echo "podslushka [toggle|start|stop|status|doctor|setup|fix-audio|protocol|pdf]"; exit 2 ;;
esac
