#!/bin/bash
# Подслушка — запись звонка и протокол
# start | stop | status | toggle | doctor | setup | fix-audio | protocol | pdf | after | finish | autostart
# Пишет микрофон и звук системы через агрегатное устройство "Podslushka In",
# после стопа расшифровывает в фоне локальным whisper — можно сразу писать дальше.

set -uo pipefail

# Приложение, запущенное из Finder, получает PATH от launchd — без
# /opt/homebrew/bin. Из терминала тот же скрипт работает, из панели падает
# на «не найден ffmpeg». Поэтому пути задаются здесь, а не наследуются.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

HOME_DIR="${PODSLUSHKA_HOME:-$HOME/.podslushka}"
DEVICE_NAME="${PODSLUSHKA_DEVICE:-Podslushka In}"
BASE_DIR="${PODSLUSHKA_DIR:-$HOME/Подслушка}"
STATE_DIR="/tmp/podslushka"
PID_FILE="$STATE_DIR/ffmpeg.pid"
CUR_FILE="$STATE_DIR/current"
LOG_FILE="$STATE_DIR/ffmpeg.log"
WHISPER_PY="$HOME_DIR/venv/bin/python"
TRANSCRIBE="$HOME_DIR/lib/transcribe.py"
PROTOCOL="$HOME_DIR/lib/protocol.py"
TOPDF="$HOME_DIR/lib/topdf.py"
MODEL2="${PODSLUSHKA_MODEL2:-large-v3}"
# Второй проход точной моделью: auto — только если первый шёл на процессоре
# (faster-whisper). На MLX первый проход уже large-v3-turbo, точный и быстрый.
SECOND_PASS="${PODSLUSHKA_SECOND_PASS:-auto}"
PEAKS="$HOME_DIR/lib/make_peaks.py"
CALLCHECK="$HOME_DIR/lib/callcheck.py"
NOCALL_FILE="$STATE_DIR/nocall"
APP_BIN="${PODSLUSHKA_APP:-$HOME/Applications/Podslushka.app/Contents/MacOS/Podslushka}"
KEEP_WAV="${PODSLUSHKA_KEEP_WAV:-0}"
# Автоцепочка после звонка: точная расшифровка → протокол на локальной
# модели → копия во «вторую память» → уведомление. Выключить: AUTO_PROTOCOL=0.
AUTO_PROTOCOL="${PODSLUSHKA_AUTO_PROTOCOL:-1}"
LLM="${PODSLUSHKA_LLM:-qwen3:30b-a3b}"
INBOX="${PODSLUSHKA_INBOX:-$HOME/Claude/Память/Входящие}"
TRACKS="$HOME_DIR/lib/tracks.py"

mkdir -p "$STATE_DIR" "$BASE_DIR"

notify() { osascript -e "display notification \"$2\" with title \"Подслушка\"" >/dev/null 2>&1; }

# Podslushka In — это [микрофон, BlackHole 2ch], звонок в двух последних
# каналах. «-ac 1» сводит 2.1 как FL+FR и выбрасывает LFE, то есть правый
# канал звонка, поэтому каналы сводятся явно: микрофон и звонок поровну,
# лимитер не даёт перегрузиться, когда говорят одновременно.
mix_filter() {
  local ch="$1"
  if ! [ "$ch" -ge 3 ] 2>/dev/null; then echo "anull"; return; fi
  local mic=$((ch - 2)) w expr="" i
  w="$(awk -v n="$mic" 'BEGIN{printf "%.4g", 1/n}')"
  for ((i = 0; i < mic; i++)); do expr="$expr${expr:+ + }$w*c$i"; done
  echo "pan=mono|c0=$expr + 0.5*c$((ch - 2)) + 0.5*c$((ch - 1)),alimiter=limit=0.97:level=0"
}

find_device_index() {
  ffmpeg -hide_banner -f avfoundation -list_devices true -i "" 2>&1 \
    | awk '/AVFoundation audio devices/{a=1;next} /AVFoundation video devices/{a=0} a' \
    | grep -F "$DEVICE_NAME" | head -1 | sed -E 's/.*\[([0-9]+)\].*/\1/'
}

# Мало проверить, что процесс с таким номером жив: после перезагрузки номер
# достаётся кому-то другому, и запись выглядит идущей, хотя её нет. Поэтому
# проверяем, что это действительно наш ffmpeg, а протухший файл убираем.
is_running() {
  [ -f "$PID_FILE" ] || return 1
  local pid cmd
  pid="$(cat "$PID_FILE" 2>/dev/null)"
  case "$pid" in
    ''|*[!0-9]*) rm -f "$PID_FILE"; return 1 ;;
  esac
  cmd="$(ps -p "$pid" -o comm= 2>/dev/null)"
  case "$cmd" in
    *ffmpeg*) return 0 ;;
    *) rm -f "$PID_FILE"; return 1 ;;
  esac
}

# Ранний отказ тоже пишется в журнал: иначе окно отправляет смотреть файл,
# которого нет.
fail() {
  local msg="$1"
  shift
  mkdir -p "$STATE_DIR"
  {
    echo "=== $(date +%H:%M:%S) старт не состоялся"
    echo "$msg"
    echo "PATH=$PATH"
    if [ $# -gt 0 ]; then printf '%s\n' "$@"; fi
  } > "$LOG_FILE"
  echo "$msg"
  notify "" "$msg"
  exit 1
}

do_start() {
  if is_running; then echo "уже пишется: $(cat "$CUR_FILE")"; exit 0; fi
  command -v ffmpeg >/dev/null \
    || fail "не найден ffmpeg, проверь установку через install.sh"

  IDX="$(find_device_index)"
  if [ -z "$IDX" ]; then
    fail "не найдено аудиоустройство \"$DEVICE_NAME\", собери его: podslushka setup" \
      "$(ffmpeg -hide_banner -f avfoundation -list_devices true -i "" 2>&1 | sed -n '/audio devices/,$p')"
  fi

  OUT_DIR="$BASE_DIR/$(date +%Y-%m-%d_%H-%M-%S)"
  mkdir -p "$OUT_DIR"
  echo "$OUT_DIR" > "$CUR_FILE"
  rm -f "$NOCALL_FILE"

  echo "=== старт $(date +%H:%M:%S), устройство [$IDX] $DEVICE_NAME" > "$LOG_FILE"
  nohup ffmpeg -hide_banner -loglevel info -nostdin \
    -f avfoundation -i ":$IDX" \
    -c:a pcm_s16le -ar 48000 \
    "$OUT_DIR/audio.wav" >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"

  sleep 1
  if ! is_running; then
    echo "ffmpeg не стартовал:"; cat "$LOG_FILE"; rm -f "$PID_FILE"; exit 1
  fi
  # Звонок, который играет мимо Podslushka Out, в запись не попадёт, а узнать
  # об этом после встречи уже поздно. Сторож предупредит через 15–20 с, если
  # в микрофоне голос, а звонка нет, и через минуту в любом случае.
  if [ -x "$WHISPER_PY" ] && [ -f "$CALLCHECK" ]; then
    nohup "$WHISPER_PY" "$CALLCHECK" live "$OUT_DIR/audio.wav" "$PID_FILE" \
      >> "$LOG_FILE" 2>&1 &
  fi
  echo "REC → $OUT_DIR/audio.wav"
  notify "" "Идёт запись"
}

# Стоп только останавливает ffmpeg и ставит запись в очередь на обработку.
# Сжатие, расшифровка и протокол идут в фоне (do_finish), поэтому панель
# сразу снова готова к записи: следующую встречу можно начинать, пока
# расшифровывается предыдущая.
do_stop() {
  if ! is_running; then echo "запись не идёт"; notify "" "Записи не было"; exit 0; fi
  PID="$(cat "$PID_FILE")"
  echo "=== стоп $(date +%H:%M:%S), pid $PID, размер до остановки $(stat -f%z "$(cat "$CUR_FILE")/audio.wav" 2>/dev/null) байт" >> "$LOG_FILE"
  kill -INT "$PID" 2>/dev/null
  for _ in $(seq 1 20); do kill -0 "$PID" 2>/dev/null || break; sleep 0.5; done
  kill -0 "$PID" 2>/dev/null && kill -9 "$PID" 2>/dev/null
  rm -f "$PID_FILE" "$NOCALL_FILE"

  OUT_DIR="$(cat "$CUR_FILE" 2>/dev/null)"
  WAV="$OUT_DIR/audio.wav"
  [ -s "$WAV" ] || { echo "файл пустой: $WAV"; notify "" "Пустой файл"; exit 1; }

  # вывод ffmpeg кладётся рядом с записью — иначе его затрёт следующий старт
  cp -f "$LOG_FILE" "$OUT_DIR/ffmpeg.log" 2>/dev/null

  nohup "$0" finish "$OUT_DIR" > "$OUT_DIR/finish.log" 2>&1 &
  echo "Запись остановлена ($(du -h "$WAV" | cut -f1)): $OUT_DIR"
  echo "  расшифровка в фоне, журнал: $OUT_DIR/finish.log — можно начинать следующую запись"
  notify "" "Стоп. Расшифровываю в фоне — можно начинать следующую запись"
}

# Очередь: обработки идут по одной, в порядке остановки. Замок — каталог
# (mkdir атомарен); замок умершего процесса снимается.
qlock() {
  local l="$STATE_DIR/$1.lock" waited=0
  while ! mkdir "$l" 2>/dev/null; do
    if [ -f "$l/pid" ] && ! kill -0 "$(cat "$l/pid" 2>/dev/null)" 2>/dev/null; then
      rm -rf "$l"; continue
    fi
    [ "$waited" = 0 ] && echo "--- жду очереди ($1): идёт обработка предыдущей записи"
    waited=1; sleep 2
  done
  echo $$ > "$l/pid"
}
qunlock() { rm -rf "$STATE_DIR/$1.lock"; }

do_finish() {
  local OUT_DIR="${1%/}"
  local WAV="$OUT_DIR/audio.wav"
  [ -s "$WAV" ] || { echo "нет записи: $WAV"; return 1; }
  qlock transcribe
  trap 'qunlock transcribe' EXIT
  echo "=== обработка $(date '+%d.%m %H:%M:%S'): $OUT_DIR"
  local SIZE NO_CALL=0 CH AUDIO
  SIZE=$(du -h "$WAV" | cut -f1)
  notify "" "Расшифровываю запись $(basename "$OUT_DIR" | cut -c12-16 | tr - :)"

  if [ -f "$CALLCHECK" ]; then
    "$WHISPER_PY" "$CALLCHECK" summary "$WAV"
    [ $? -eq 3 ] && NO_CALL=1
  fi

  # WAV 48 кГц — около гигабайта в час, поэтому жмём в моно m4a. Расшифровка
  # идёт уже по нему: так whisper слышит обе стороны так же, как человек.
  CH="$(ffprobe -v error -select_streams a:0 -show_entries stream=channels -of csv=p=0 "$WAV")"
  # До сведения в моно — громкость микрофона и звонка отдельно: по ней
  # расшифровка подпишет реплики «Они» и «Я».
  if [ "$CH" -ge 3 ] 2>/dev/null && [ "$NO_CALL" = 0 ] && [ -f "$TRACKS" ]; then
    "$WHISPER_PY" "$TRACKS" envelope "$WAV" "$OUT_DIR/tracks.json" || echo "  дорожки не снялись"
  fi
  if ffmpeg -v error -y -nostdin -i "$WAV" -af "$(mix_filter "$CH")" -ac 1 -c:a aac -b:a 64k \
       -movflags +faststart "$OUT_DIR/audio.m4a"; then
    echo "  сжато: $SIZE → $(du -h "$OUT_DIR/audio.m4a" | cut -f1), каналов свели: $CH"
  else
    rm -f "$OUT_DIR/audio.m4a"
    echo "  сжатие не вышло, оставляю WAV"
  fi
  AUDIO="$OUT_DIR/audio.m4a"; [ -f "$AUDIO" ] || AUDIO="$WAV"

  if ! "$WHISPER_PY" "$TRANSCRIBE" "$AUDIO"; then
    notify "" "Ошибка транскрибации"
    echo "Расшифровка упала, аудио цело: $AUDIO"
    return 1
  fi

  "$WHISPER_PY" "$PEAKS" "$AUDIO" || echo "  пики не посчитались"

  if [ "$KEEP_WAV" != "1" ] && [ "$AUDIO" != "$WAV" ]; then rm -f "$WAV"; fi

  echo "Готово: $OUT_DIR"
  if [ "$NO_CALL" = 1 ]; then
    echo "  ВНИМАНИЕ: звука звонка в записи нет, только микрофон."
    echo "  В приложении звонка выбери динамик Podslushka Out или включи «Переключать звук самому»."
    notify "" "Транскрипт готов, но звука звонка в записи нет — только микрофон"
  else
    notify "" "Транскрипт готов"
  fi
  # Папку открываем, только если не идёт новая запись: окно Finder посреди
  # следующей встречи мешает.
  is_running || open "$OUT_DIR"
  qunlock transcribe
  trap - EXIT

  # Протокол — своей очередью: локальная модель думает минутами, а
  # расшифровка следующей записи ждать её не должна.
  if [ "$SECOND_PASS" != "0" ] || [ "$AUTO_PROTOCOL" = "1" ]; then
    echo "--- дальше протокол, журнал: $OUT_DIR/after.log"
    do_after "$OUT_DIR" "$AUDIO" > "$OUT_DIR/after.log" 2>&1
  fi
}

# Цепочка после звонка. $1 — папка звонка, $2 — аудио (по умолчанию audio.m4a).
# Каждый шаг пишет в after.log; упавший шаг не валит остальные: без точной
# расшифровки протокол строится по черновику.
do_after() {
  local D="${1%/}" A="${2:-}" t0 name copy
  [ -d "$D" ] || { echo "нет папки: $D"; return 1; }
  [ -n "$A" ] || A="$D/audio.m4a"
  [ -f "$A" ] || A="$D/audio.wav"
  qlock protocol
  trap 'qunlock protocol' EXIT
  t0=$(date +%s)
  echo "=== цепочка $(date '+%d.%m %H:%M:%S'): $D"

  local second="$SECOND_PASS"
  if [ "$second" = "auto" ]; then
    second=1
    grep -q '"engine": "mlx"' "$D/meta.json" 2>/dev/null && second=0
  fi
  if [ "$second" = "1" ] && [ -n "$MODEL2" ] && [ "$MODEL2" != "${PODSLUSHKA_MODEL:-large-v3-turbo}" ] && [ -f "$A" ]; then
    cp -f "$D/transcript.txt" "$D/transcript-draft.txt" 2>/dev/null
    echo "--- точная расшифровка ($MODEL2)"
    if PODSLUSHKA_MODEL="$MODEL2" "$WHISPER_PY" "$TRANSCRIBE" "$A"; then
      [ "$AUTO_PROTOCOL" = "1" ] || notify "" "Точная расшифровка готова"
    else
      echo "второй проход не удался, протокол — по черновику"
      notify "" "Второй проход не удался"
    fi
  fi

  [ "$AUTO_PROTOCOL" = "1" ] || return 0
  echo "--- протокол ($LLM)"
  rm -f "$D/protocol.md"
  "$WHISPER_PY" "$PROTOCOL" "$D" --engine ollama --model "$LLM"
  if [ ! -s "$D/protocol.md" ]; then
    echo "протокола нет (короткий звонок или модель не ответила)"
    notify "" "Протокол не собрался — см. after.log в папке звонка"
    return 1
  fi
  "$WHISPER_PY" "$TOPDF" "$D/protocol.md" "$D/protocol.pdf" >/dev/null 2>&1 || echo "PDF не собрался"

  # Имя по времени начала звонка, из имени папки ГГГГ-ММ-ДД_ЧЧ-ММ-СС.
  name="$(basename "$D")"
  if [ -d "$INBOX" ]; then
    copy="$INBOX/${name:0:10}_звонок_${name:11:5}.md"
    [ -e "$copy" ] && copy="$INBOX/${name:0:10}_звонок_${name:11:8}.md"
    { cat "$D/protocol.md"; printf '\n---\nИсточник: %s · расшифровка %s · протокол %s\n' \
        "$D" "$(sed -n 's/.*"model": "\(.*\)".*/\1/p' "$D/meta.json" 2>/dev/null | head -1)" "$LLM"; } > "$copy"
    echo "копия: $copy"
    notify "" "Протокол готов: $(basename "$copy")"
  else
    echo "нет папки $INBOX — протокол только в $D"
    notify "" "Протокол готов (папки Входящие нет)"
  fi
  echo "=== готово за $(( $(date +%s) - t0 )) с"
}

# Автозапуск при входе: LaunchAgent открывает приложение через LaunchServices,
# как двойной клик в Finder, — разрешения на микрофон те же. Перезапуском не
# занимается: закрыл панель — до следующего входа её нет.
AGENT_LABEL="com.podslushka.autostart"
AGENT_PLIST="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"
do_autostart() {
  local app="${APP_BIN%/Contents/MacOS/*}"
  case "${1:-status}" in
    on)
      [ -d "$app" ] || { echo "нет приложения: $app"; return 1; }
      mkdir -p "$(dirname "$AGENT_PLIST")"
      cat > "$AGENT_PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$AGENT_LABEL</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/open</string><string>-g</string><string>$app</string></array>
  <key>RunAtLoad</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
</dict>
</plist>
PL
      plutil -lint "$AGENT_PLIST" >/dev/null || { echo "plist не прошёл проверку"; return 1; }
      launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null
      launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST" \
        && echo "автозапуск включён: $app откроется при входе" ;;
    off)
      launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null
      rm -f "$AGENT_PLIST"; echo "автозапуск выключен" ;;
    *)
      if [ -f "$AGENT_PLIST" ] && launchctl print "gui/$(id -u)/$AGENT_LABEL" >/dev/null 2>&1; then
        echo "автозапуск включён ($AGENT_PLIST)"
      else
        echo "автозапуск выключен"; return 1
      fi ;;
  esac
}

# Выбранная папка кладётся в DIR, а не печатается: подстановка $(...) уходит
# в подоболочку, и выход по ошибке оттуда не останавливает вызывающего.
DIR=""
pick_dir() {
  if [ -n "${1:-}" ]; then
    DIR="${1%/}"
    [ -d "$DIR" ] || { echo "нет папки: $DIR"; return 1; }
    return 0
  fi
  local d
  d="$(ls -dt "$BASE_DIR"/*/ 2>/dev/null | head -1)"
  if [ -z "$d" ]; then
    echo "В $BASE_DIR записей нет."
    echo "Если записи лежат в другом месте, укажи папку явно или задай PODSLUSHKA_DIR."
    return 1
  fi
  DIR="${d%/}"
}

do_protocol() {
  pick_dir "${1:-}" || return 1
  local D="$DIR"
  echo "Протокол по $D"
  "$WHISPER_PY" "$PROTOCOL" "$D" || return 1
  if [ -f "$D/protocol.md" ]; then
    "$WHISPER_PY" "$TOPDF" "$D/protocol.md" "$D/protocol.pdf" && open "$D"
  fi
}

do_pdf() {
  pick_dir "${1:-}" || return 1
  local D="$DIR"
  [ -f "$D/protocol.md" ] || { echo "нет $D/protocol.md — сначала podslushka protocol"; return 1; }
  "$WHISPER_PY" "$TOPDF" "$D/protocol.md" "$D/protocol.pdf" && open "$D"
}

do_doctor() {
  local ok=0
  check() { if eval "$2" >/dev/null 2>&1; then echo "  есть   $1"; else echo "  НЕТ    $1"; ok=1; fi; }
  echo "Подслушка, проверка окружения:"
  check "ffmpeg"                 "command -v ffmpeg"
  check "драйвер BlackHole 2ch"  "test -d /Library/Audio/Plug-Ins/HAL/BlackHole2ch.driver"
  check "python окружения"       "test -x '$WHISPER_PY'"
  check "faster-whisper"         "'$WHISPER_PY' -c 'import faster_whisper'"
  check "устройство ${DEVICE_NAME}" "test -n \"\$(find_device_index)\""
  check "папка записей"          "test -d '$BASE_DIR' || mkdir -p '$BASE_DIR'"
  echo "  ---- для протоколов, не обязательно ----"
  if "$WHISPER_PY" -c 'import mlx_whisper' >/dev/null 2>&1; then
    echo "  есть   mlx-whisper: расшифровка на видеоядре, второй проход не нужен"
  else
    echo "  нет    mlx-whisper — расшифровка на процессоре: $HOME_DIR/venv/bin/pip install mlx-whisper"
  fi
  if [ -d "$HOME/.cache/huggingface/hub/models--Systran--faster-whisper-$MODEL2" ]; then
    echo "  есть   точная модель $MODEL2"
  else
    echo "  нет    точной модели $MODEL2 — скачается при первом втором проходе"
  fi
  if curl -s -m 3 http://127.0.0.1:11434/api/tags 2>/dev/null | grep -qF "\"$LLM\""; then
    echo "  есть   ollama с $LLM, протокол после звонка соберётся сам"
  elif command -v ollama >/dev/null; then
    echo "  нет    модели $LLM в ollama (или сервер не запущен) — ollama pull $LLM"
  else
    echo "  нет    ollama — протокол выйдет заготовкой для внешней модели"
  fi
  if do_autostart status >/dev/null; then echo "  есть   автозапуск при входе"
  else echo "  нет    автозапуска при входе — podslushka autostart on"; fi
  doctor_route || ok=1
  echo
  if [ "$ok" = 0 ]; then echo "Всё на месте."; else echo "Чего-то не хватает — см. строки НЕТ выше"; fi
  return $ok
}

# Запись в наушниках: звонок должен идти через Podslushka Out, иначе в BlackHole
# тишина и в запись попадает только микрофон. Состояние звука знает только
# приложение (CoreAudio), поэтому спрашиваем у него, ничего не переключая.
doctor_route() {
  echo "  ---- запись в наушниках ----"
  if [ ! -x "$APP_BIN" ]; then
    echo "  нет    приложения — маршрут звука не проверить, собери: $HOME_DIR/app/build.sh"
    return 0
  fi
  # Старое приложение не знает --audio-report и вместо ответа открыло бы окно.
  if ! grep -aq "podslushka-audio-report-v1" "$APP_BIN"; then
    echo "  НЕТ    приложение старое, проверки маршрута в нём нет — обнови: $HOME_DIR/app/build.sh"
    return 1
  fi
  local rep bad=0 rec=0
  rep="$("$APP_BIN" --audio-report 2>/dev/null)"
  is_running && rec=1
  route_verdict "$rep" "$rec" || bad=1
  return $bad
}

# Разбор отчёта приложения отдельно от запуска — так его можно проверить
# на заготовленных строках. $1 — отчёт, $2 — 1, если идёт запись.
route_verdict() {
  local rep="$1" rec="$2" bad=0 out kind auto setout mic mick subs st prob
  out="$(printf '%s\n' "$rep" | awk -F'\t' '$1=="output"{print $2}')"
  kind="$(printf '%s\n' "$rep" | awk -F'\t' '$1=="output"{print $3}')"
  auto="$(printf '%s\n' "$rep" | awk -F'\t' '$1=="autoswitch"{print $2}')"
  setout="$(printf '%s\n' "$rep" | awk -F'\t' '$1=="setting_out"{print $2}')"
  mic="$(printf '%s\n' "$rep" | awk -F'\t' '$1=="setting_mic"{print $2}')"
  mick="$(printf '%s\n' "$rep" | awk -F'\t' '$1=="setting_mic"{print $3}')"
  subs="$(printf '%s\n' "$rep" | awk -F'\t' '$1=="podout_subs"{print $2}')"
  st="$(printf '%s\n' "$rep" | awk -F'\t' '$1=="podout"{print $2}')"
  prob="$(printf '%s\n' "$rep" | awk -F'\t' '$1=="podout"{print $3}')"
  if [ -z "$kind" ]; then
    echo "  НЕТ    приложение не ответило на --audio-report"
    return 1
  fi

  echo "  ...    системный выход сейчас: $out"
  echo "  ...    выход в настройках Подслушки: $setout; внутри Podslushka Out: ${subs:-нет устройства}"
  if [ "$st" = "ok" ]; then
    echo "  есть   Podslushka Out исправен и совпадает с выходом"
  else
    echo "  НЕТ    Podslushka Out: $prob"
    echo "         пересобери: меню Подслушки → «Пересобрать устройства» (или спросит при записи)"
    bad=1
  fi

  if [ "$rec" = 1 ]; then
    if [ "$kind" = "podslushka-out" ]; then
      echo "  есть   идёт запись, системный выход — Podslushka Out"
    elif [ "$kind" = "headphones" ]; then
      echo "  НЕТ    идёт запись, а звук идёт прямо в «$out» мимо Podslushka Out — звонка в записи не будет"
      bad=1
    else
      echo "  ...    идёт запись через динамики: собеседника ловит микрофон"
    fi
  elif [ "$kind" = "headphones" ]; then
    echo "  ...    при записи выход сам переключится на Podslushka Out (в наушниках — всегда)"
  elif [ "$kind" = "speakers" ] && [ "$auto" != "1" ]; then
    echo "  ...    динамики, автопереключение выключено: собеседника будет ловить микрофон"
  fi

  case "$mick" in
    bluetooth) echo "  совет  микрофон «$mic» — Bluetooth: AirPods уйдут в режим гарнитуры, звук хуже."
               echo "         Возьми микрофон MacBook — меню «Микрофон», и тот же в приложении звонка." ;;
    missing)   echo "  НЕТ    микрофона «$mic» сейчас нет — подключи его или выбери другой в меню «Микрофон»"
               bad=1 ;;
  esac

  local by
  by="$(printf '%s\n' "$rep" | awk -F'\t' '$1=="bypass"{print $2}')"
  if [ -n "$by" ]; then
    if [ "$rec" = 1 ]; then
      echo "  НЕТ    играют мимо Podslushka Out (в запись не попадут):"; bad=1
    else
      echo "  ...    сейчас играют мимо Podslushka Out (если это звонок — выбери в нём динамик Podslushka Out):"
    fi
    printf '%s\n' "$by" | sed 's/^/           /'
  fi
  return $bad
}

do_setup() {
  APP="$HOME/Applications/Podslushka.app/Contents/MacOS/Podslushka"
  [ -x "$APP" ] || { echo "нет приложения, собери: $HOME_DIR/app/build.sh"; exit 1; }
  echo "Доступные устройства:"; "$APP" --devices
  echo
  echo "Создать вход и выход из микрофона и наушников:"
  echo "  \"$APP\" --mic \"Микрофон MacBook Pro\" --out \"Динамики MacBook Pro\" --make-devices"
}

do_fix_audio() {
  APP="$HOME/Applications/Podslushka.app/Contents/MacOS/Podslushka"
  if [ -x "$APP" ]; then
    "$APP" --restore-output
  else
    echo "нет приложения. Верни выход вручную: Option и клик по значку звука в строке меню."
    exit 1
  fi
}

case "${1:-toggle}" in
  route-verdict) shift; route_verdict "${1:-}" "${2:-0}"; exit $? ;;
  doctor) do_doctor; exit $? ;;
  fix-audio) do_fix_audio; exit $? ;;
  protocol) shift; do_protocol "${1:-}"; exit $? ;;
  pdf) shift; do_pdf "${1:-}"; exit $? ;;
  after) shift; do_after "${1:-}" "${2:-}"; exit $? ;;
  finish) shift; do_finish "${1:-}"; exit $? ;;
  autostart) shift; do_autostart "${1:-status}"; exit $? ;;
  setup) do_setup ;;
  start) do_start ;;
  stop) do_stop ;;
  status)
    if is_running; then
      echo "идёт запись: $(cat "$CUR_FILE" 2>/dev/null)"
      echo "процесс: $(ps -p "$(cat "$PID_FILE")" -o pid=,comm= 2>/dev/null)"
    else
      echo "запись не идёт"
      [ -f "$PID_FILE" ] || echo "состояние чистое"
    fi
    ;;
  toggle) is_running && do_stop || do_start ;;
  *) echo "podslushka [toggle|start|stop|status|doctor|setup|fix-audio|protocol|pdf|after|autostart on|off]"; exit 2 ;;
esac
